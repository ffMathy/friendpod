{
  "specRoot": "ail",
  "checksDir": "checks",
  "migrate": "node-by-node",
  "run": {
    "legacy": {
      "start": "scripts/ail/run-legacy.sh",
      "cwd": ".",
      "ready": "http://127.0.0.1:8090/",
      "timeout": 300,
      "env": {
        "AIL_APP_URL": "http://127.0.0.1:8090"
      }
    },
    "app": {
      "start": "scripts/ail/run-legacy.sh",
      "cwd": ".",
      "ready": "http://127.0.0.1:8090/",
      "timeout": 300,
      "env": {
        "AIL_APP_URL": "http://127.0.0.1:8090"
      }
    }
  }
}
