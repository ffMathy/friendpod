{
  "name": "@friendpod/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Friendpod app: Expo SDK 58 + React Native Firebase 27 (DESIGN.md §11). Dev builds only; RNFirebase does not run in Expo Go.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "fetch-model": "node --use-env-proxy scripts/fetch-model.mjs",
    "eas-build-pre-install": "npm run fetch-model",
    "preandroid": "npm run fetch-model",
    "android": "expo run:android",
    "preios": "npm run fetch-model",
    "ios": "expo run:ios",
    "config": "expo config --type public",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "preview:check": "tsx preview/check.mts",
    "preview:typecheck": "tsc --noEmit -p preview/tsconfig.json",
    "preview:build": "node preview/shoot.mjs --build-only",
    "preview:serve": "node preview/serve.mjs",
    "preview:shoot": "node preview/shoot.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "0.4.2",
    "@expo/metro-runtime": "58.0.17",
    "@friendpod/core": "*",
    "@huggingface/tokenizers": "0.2.0",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/app-check": "27.1.0",
    "@react-native-firebase/auth": "27.1.0",
    "@react-native-firebase/firestore": "27.1.0",
    "@react-native-firebase/functions": "27.1.0",
    "@react-native-firebase/messaging": "27.1.0",
    "@react-native-firebase/storage": "27.1.0",
    "@react-native-google-signin/google-signin": "17.0.0",
    "@tanstack/react-query": "5.105.3",
    "expo": "58.0.23",
    "expo-apple-authentication": "58.0.2",
    "expo-build-properties": "58.0.12",
    "expo-calendar": "58.0.6",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.18",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-image": "58.0.18",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.16",
    "expo-localization": "58.0.5",
    "expo-location": "58.0.20",
    "expo-router": "58.0.30",
    "expo-screen-capture": "58.0.6",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.13",
    "expo-system-ui": "58.0.7",
    "i18next": "26.7.1",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.3.0",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.12",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  }
}
