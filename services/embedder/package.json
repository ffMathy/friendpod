{
  "name": "grouper-embedder",
  "version": "0.0.0",
  "private": true,
  "description": "Functions codebase \"embedder\": addInterests and embedderBatch with a self-hosted EmbeddingGemma (DESIGN.md §5, §10.2). Standalone npm project; run `npm ci` at the repo root first (packages/core is bundled from source).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "node esbuild.config.mjs && node scripts/build-prototypes.mjs --if-model",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --project demo-grouper --only firestore \"vitest run\"",
    "fetch-model": "node scripts/fetch-model.mjs",
    "build-prototypes": "node scripts/build-prototypes.mjs",
    "gcp-build": "node scripts/prune-ort.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
