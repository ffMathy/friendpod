{
  "name": "@friendpod/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared domain logic for Friendpod: schemas, interest checks, geo, time, IDs, consent texts and the pure matcher. Consumed as TypeScript source.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "gen:postcodes": "tsx scripts/gen-postcodes.ts",
    "gen:areas": "tsx scripts/gen-areas.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
